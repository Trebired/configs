{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    }
  },
  "name": "@trebired/configs",
  "version": "0.4.0",
  "description": "Shared Trebired configuration presets for Code Discipline and @trebired/frontend.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./.trebired/code-discipline/config.ts",
